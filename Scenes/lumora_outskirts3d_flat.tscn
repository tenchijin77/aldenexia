[node name="WagonNote" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -591.6, 0, -568.3)
script = ExtResource("world_note_scr")
title = "Torn Shipping Note"
note_text = "A shipping note, water-stained and scorched at one corner, pinned under a broken wheel. A clerk's tidy hand, going ragged toward the bottom:\nConsignment 14: one strongbox, house seal, for the Wardens' paymaster at Lumora. Brigands on the south road, the driver says. If this reaches anyone: we were robbed by a man called Dessik. He wears the box on his belt like a trophy, and he laughs about it.\nTake it back for us, whoever you are. The Wardens will pay."
start_quest = "wagon_crash"

