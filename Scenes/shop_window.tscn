[gd_scene format=3 uid="uid://shop_window01"]

[ext_resource type="Script" path="res://Scripts/shop_window.gd" id="1_shopwin"]

[node name="ShopWindow" type="CanvasLayer"]
script = ExtResource("1_shopwin")

[node name="Panel" type="Panel" parent="."]
offset_left = 220.0
offset_top = 120.0
offset_right = 480.0
offset_bottom = 460.0

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleBar" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Panel/Margin/VBox/TitleBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "🛒  Shop"
theme_override_font_sizes/font_size = 14

[node name="CloseBtn" type="Button" parent="Panel/Margin/VBox/TitleBar"]
layout_mode = 2
text = "✕"

[node name="CoinLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "You have: 0pp 0gp 0sp 0cp"
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.9, 0.8, 0.5, 1)

[node name="HSep1" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="BuyLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "For Sale"
theme_override_font_sizes/font_size = 12

[node name="BuyScroll" type="ScrollContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="BuyList" type="VBoxContainer" parent="Panel/Margin/VBox/BuyScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="HSep2" type="HSeparator" parent="Panel/Margin/VBox"]
layout_mode = 2

[node name="SellLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Your Items"
theme_override_font_sizes/font_size = 12

[node name="SellScroll" type="ScrollContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="SellList" type="VBoxContainer" parent="Panel/Margin/VBox/SellScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4
