# Written by tools/stamp_build.sh right before an export (exact git commit of the build)
Data/build_info.json

# Everything tools/update.sh and the editor export: client builds (Windows/Linux), the dedicated server (~150 MB binary;
# GitHub rejects files over 100 MB), the update bases (Builds/Base) and the last patches/manifest (Builds/Update).
Builds/
/logs/
